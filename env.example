# ============================================================================
# Gemini Enterprise Web-to-API Bridge 配置文件模板
# 复制本文件为 .env 即可自定义配置（start.ps1 首次运行会自动生成 .env）
# ============================================================================

# 本地监听地址与端口（建议仅绑定 127.0.0.1 保障企业数据安全）
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000

# 本地接口鉴权密钥：留空则允许客户端填写任意 Key（如 sk-local-bridge）；
# 若设置具体字符串，则客户端必须填写相同的 Bearer Key
BRIDGE_API_KEY=

# 上游运行模式：
#   browser - 方案二：真实浏览器扩展 / 油猴桥接（默认，零逆向风控）
#   gcloud  - 方案一：官方 Google Cloud CLI ADC 调用（需 GCP 项目权限）
#   auto    - 优先使用已连接的浏览器页面，未连接时回退至 gcloud
BRIDGE_BACKEND_MODE=browser

# 多轮对话上下文策略：
#   smart        - 智能增量追踪（默认：同一会话仅发送最新一轮，切换历史自动打包上下文）
#   last_message - 仅发送最后一条用户消息
#   transcript   - 每次拼接完整历史上下文
BRIDGE_CONTEXT_MODE=smart

# 超时设置（秒）
BRIDGE_REQUEST_TIMEOUT=600
BRIDGE_QUEUE_TIMEOUT=300

# 是否附带企业知识库参考链接（Enterprise Grounding Citations）
BRIDGE_INCLUDE_CITATIONS=true

# 本地客户端新建会话或切换会话时，是否自动在网页端开启全新的 Gemini 会话（默认开启，确保本地会话与网页会话一一隔离）
BRIDGE_AUTO_RESET_NEW_CHAT=true

# 并行多会话池配置：
#   BRIDGE_MAX_PARALLEL_TABS    - 最大并行浏览器工作标签页数量（默认 6）
#   BRIDGE_AUTO_SPAWN_TABS      - 当多会话并发或现有标签页被活跃会话占用时，自动在后台静默新建工作标签页（默认 true）
#   BRIDGE_SESSION_AFFINITY_TTL - 活跃会话在工作标签页上的粘性保留时间（秒，默认 300）
BRIDGE_MAX_PARALLEL_TABS=6
BRIDGE_AUTO_SPAWN_TABS=true
BRIDGE_SESSION_AFFINITY_TTL=300

# 启动时自动生成独立 extension/（含 PNG 图标）与 userscript/ 目录
BRIDGE_AUTO_EXPORT_EXTENSION=true

# 用量统计与官方 API 等价换算配置：
#   BRIDGE_USAGE_STATS_PATH - 持久化用量账本路径（留空默认保存在项目目录 usage_stats.json）
#   BRIDGE_USD_TO_CNY_RATE  - 美元兑人民币近似汇率（用于插件弹窗/控制台折算展示，默认 7.25）
BRIDGE_USAGE_STATS_PATH=
BRIDGE_USD_TO_CNY_RATE=7.25

# ============================================================================
# 可选：方案一（官方 GCloud CLI / Vertex AI & Agentspace API）参数
# 若拥有 GCP IAM 权限，执行 `gcloud auth application-default login` 后填写：
# ============================================================================
GCP_PROJECT_ID=
GCP_LOCATION=global
GCP_VERTEX_LOCATION=us-central1
GCP_VERTEX_MODEL=gemini-2.5-pro
# 若调用 Discovery Engine (Agentspace) streamAssist，可填写 Engine ID：
GCP_ENGINE_ID=
GCP_COLLECTION_ID=default_collection
