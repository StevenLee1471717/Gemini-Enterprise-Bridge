{
  "manifest_version": 3,
  "name": "Gemini Enterprise Web-to-API Bridge",
  "version": "1.2.0",
  "description": "Bridge Google Cloud Vertex AI Search / Agentspace web sessions to a local OpenAI-compatible API server.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://vertexaisearch.cloud.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Enterprise Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vertexaisearch.cloud.google.com/*"
      ],
      "js": [
        "page-driver.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vertexaisearch.cloud.google.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
